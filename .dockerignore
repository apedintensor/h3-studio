# Send only the application source and pinned dependencies to Docker.
**
!Dockerfile
!.dockerignore
!requirements.lock.txt
!server.py
!password_auth.py
!comfy_workflow.py
!comfy-object-info.json
!tools/
!tools/manage_users.py
!web/
!web/index.html
!web/app.js
!web/styles.css
!web/h3-ref-bf16-workflow.json

# Separate v1 image inputs. No runtime directories or central vault are included.
!Dockerfile.platform
!platform_app.py
!studio_platform/
!studio_platform/*.py
!studio_platform/inference/
!studio_platform/inference/*.py
!studio_platform/runtime_hosts/
!studio_platform/runtime_hosts/*.py
!yingxu/
!yingxu/package.json
!yingxu/package-lock.json
!yingxu/index.html
!yingxu/vite.config.js
!yingxu/source-manifest.json
!yingxu/src/
!yingxu/src/*.js
!yingxu/src/*.jsx
!yingxu/src/*.css
!yingxu/src/*.json
!skills/
!skills/sixnine-yingxu/
!skills/sixnine-yingxu/SKILL.md
!skills/sixnine-yingxu/scripts/
!skills/sixnine-yingxu/scripts/sixnine.py
!skills/sixnine-yingxu/scripts/connect.py
