# Non-secret deployment settings only; no provider keys, passwords or sessions.
# Copy to /srv/h3-studio/config/site.env on the target VM after choosing the
# hostname. Empty required values prevent Compose startup.

# DNS hostname only, without scheme, port, path or wildcard.
H3_DOMAIN=

# Immutable source commit. The release script fills these for each deployment.
H3_RELEASE=
H3_IMAGE=

# This CPU deployment fixes H3_GENERATION_ENABLED=0 in compose.yaml.
# It neither creates nor connects to a GPU, and contains no cloud credentials.
# H3_AUTH_MODE=password is also fixed; provision accounts before readiness.
